# Required. How to get one: see README "Getting your NPSSO".
NPSSO=
# Recommended after setting/changing NPSSO: run `psn-captures-backup auth`
# (or `auth --check`) to create/refresh PSN_TOKEN_FILE before starting the daemon.

# Optional overrides (defaults shown).
PSN_OUTPUT_DIR=./captures
# State and token default to files inside PSN_OUTPUT_DIR. Set them explicitly
# when sharing that folder with immich-go/rclone/etc., so secrets stay out of it.
# PSN_STATE_FILE=./captures/.psn-captures-state.sqlite
# PSN_TOKEN_FILE=./captures/.psn-token.json  # created by 'auth'; keep on persistent storage
PSN_POLL_INTERVAL=21600
PSN_MAX_CONCURRENCY=2
PSN_UPLOAD_CONCURRENCY=2
PSN_UPLOAD_QUEUE_LIMIT=4
PSN_INCLUDE_IMAGES=true
PSN_INCLUDE_VIDEOS=true
PSN_LOG_LEVEL=INFO
# PSN_METRICS_ADDR=0.0.0.0:9101  # optional Prometheus /metrics endpoint (daemon)

# PSN_POST_DOWNLOAD_SCRIPT=/path/to/hook.sh
# PSN_POST_DOWNLOAD_DEBOUNCE_SECONDS=10  # default 0 (hook per download); e.g. 10 to batch
