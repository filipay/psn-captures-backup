# Required. How to get one: see README "Getting your NPSSO".
NPSSO=

# Optional overrides (defaults shown).
PSN_OUTPUT_DIR=./captures
# PSN_STATE_FILE=./captures/.psn-captures-state.sqlite
# PSN_TOKEN_FILE=./captures/.psn-token.json
PSN_POLL_INTERVAL=21600
PSN_MAX_CONCURRENCY=2
PSN_UPLOAD_CONCURRENCY=2
PSN_UPLOAD_QUEUE_LIMIT=4
PSN_INCLUDE_IMAGES=true
PSN_INCLUDE_VIDEOS=true
PSN_LOG_LEVEL=INFO
# PSN_POST_DOWNLOAD_SCRIPT=/path/to/hook.sh
